  "event_config": {
    "initial_posts": [
      {
        "poster_agent_id": 6,
        "content": "We are evaluating Volt across our 14-person startup to replace timesheets and distribute our quarterly team bonus pool based on verified output. I need honest feedback from our engineering leads, junior devs, and ops: what would need to be true for you to trust this with your compensation?"
      },
      {
        "poster_agent_id": 8,
        "content": "From an operations and HR perspective, how do we handle the shift from fixed predictable pay to variable weightage points? What about legal employment contracts, junior career growth, and non-technical teammates who don't touch Git or CLI? What are the actual implementation barriers?"
      },
      {
        "poster_agent_id": 9,
        "content": "Examining the latest Volt architecture (Docs 14-16): they introduced dual scoring modes (time-based default vs VoltAI optional) and plain-language custom manager rubrics. Does this shift make it viable for teams of 8-20, or is the configuration burden still too high?"
      }
    ]
  }
